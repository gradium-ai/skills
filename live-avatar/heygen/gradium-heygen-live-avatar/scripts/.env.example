# Copy to .env next to orchestrator.py. Only the server reads this file; the
# browser never sees any of it. Never commit the real .env.

# ── Required ──────────────────────────────────────────────────────────────────
# Gradium: speech-to-text and text-to-speech. https://gradium.ai
GRADIUM_API_KEY=

# HeyGen LiveAvatar: the animated face. https://app.liveavatar.com/developers
LIVEAVATAR_API_KEY=

# Any OpenAI-compatible chat-completions endpoint and model. The base URL must
# be https:// unless it points at localhost.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# ── Voice ─────────────────────────────────────────────────────────────────────
# A Gradium flagship voice_id, or a permanent designed/cloned voice. The
# language must match the voice (en, fr, de, es, pt).
GRADIUM_VOICE_ID=YTpq7expH9539ERJ
GRADIUM_LANGUAGE=en
# GRADIUM_TTS_MODEL=default
# GRADIUM_TTS_PADDING_BONUS=-1.0      # negative = slightly faster, positive = slower
# GRADIUM_STT_DELAY_FRAMES=8          # 7-10 for conversation; higher = more accurate, slower
# GRADIUM_KEYWORDS=Gradium,HeyGen     # product names the transcriber should spell right

# ── Turn-taking ───────────────────────────────────────────────────────────────
# TURN_THRESHOLD=0.7                  # inactivity probability that ends a turn
# TURN_HORIZON_S=2.0                  # VAD horizon to read (0.5, 1.0, 2.0, 3.0)
# TURN_CONSECUTIVE_STEPS=2            # 80 ms steps that must agree

# ── Avatar ────────────────────────────────────────────────────────────────────
# Leave empty to use the first active public avatar (the server logs which).
LIVEAVATAR_AVATAR_ID=
# LIVEAVATAR_SANDBOX=1                # free sessions (~1 minute, sandbox avatar only)
# LIVEAVATAR_VIDEO_QUALITY=high       # very_high | high | medium | low

# ── Server ────────────────────────────────────────────────────────────────────
# HOST=127.0.0.1                      # loopback only: there is no authentication
# PORT=8787
# MAX_SESSIONS=2
# MAX_SESSION_S=600
# IDLE_TIMEOUT_S=60
# LOG_TRANSCRIPTS=0                   # 1 logs what was said; off by default
